# =========================
# VS Code & IntelliSense
# =========================
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Локальная история файлов (расширение Local History)
.history/

# Кэш C/C++ расширения
.ipch/
*.VC.db
*.opensdf
*.sdf
*.suo

# =========================
# PlatformIO (Самый частый сборщик для ESP32 в VS Code)
# =========================
.pio/
.piolibdeps/

# =========================
# ESP-IDF / Standard C++ Build (Если собираешь без PlatformIO)
# =========================
build/
sdkconfig.old
*.elf
*.bin
*.map
*.hex
*.uf2
*.o
*.obj
*.a
*.out

# =========================
# Платформо-зависимые файлы (OS)
# =========================
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
Thumbs.db
ehthumbs.db
desktop.ini

# =========================
# POV Display File System (LittleFS / SPIFFS)
# =========================
# Игнорируем случайно закинутые картинки или бинарники анимаций
data/*.bin
data/*.gif
data/*.jpg
data/*.png

# НО принудительно оставляем файлы веб-интерфейса!
!data/index.html
!data/*.css
!data/*.js

# =========================
# Архивы лога Холла (приложение: долгий тап по Render POV Video → Export)
# =========================
# Записи поездок, на GitHub им не место — где бы в репозитории ни лежали.
pov-hall-log-*.zip

# =========================
# Android / Gradle (приложение в android/)
# =========================
# Кэш и блокировки Gradle и Kotlin-демона: переписываются при каждой сборке.
# Выходные APK уже покрыты правилом build/ выше.
.gradle/
.kotlin/

# =========================
# GIF-файлы
# =========================
# Записи и черновые гифки весят сотни мегабайт, а GitHub не принимает файлы больше 100 МБ.
# Анимации README — анимированный WebP (docs/images/*.webp): меньше и чётче GIF.
# Если гифка всё же нужна, добавлять осознанно: git add -f.
*.gif
